# .env.example: names, defaults and rules from Appendix B10 of the master specification (docs/spec/B4.md).
# Every variable is commented out on purpose: copy this file to .env (git-ignored) and uncomment only what you set.
# There is NO weak default for any secret. Secrets are accepted as NAME (value), NAME_FILE (path to a 0600 file) or systemd credentials.
# Startup fails loudly on missing or weak required secrets. Generate keys with `cargo xtask gen-secrets` (T-0005). There is no DEV_MODE.

# Label only; changes no behavior.
# default: `production` | required: no
#HDD_ENV_NAME=

# `owner_only` or `saas`.
# default: `owner_only` | required: no
#HDD_DEPLOYMENT_MODE=

# Registrable domain.
# default: none | required: yes
#HDD_PLATFORM_DOMAIN=

# Loopback or private only unless `HDD_API_PUBLIC=true`.
# default: `127.0.0.1:8000` | required: no
#HDD_API_BIND=

# Same rule; public surfaces are reached through the proxy.
# default: `127.0.0.1:3000` | required: no
#HDD_WEB_BIND=

# Opt-in; logs a WARN.
# default: `false` | required: no
#HDD_API_PUBLIC=

# Host network.
# default: `0.0.0.0:80` / `0.0.0.0:443` | required: no
#HDD_PROXY_BIND_HTTP=

# UDP+TCP.
# default: `0.0.0.0:53` | required: no
#HDD_DNS_BIND=

# `sslmode=verify-full` or Unix socket.
# default: none | required: yes
#HDD_DATABASE_URL=

# Read-only roles for proxy/DNS.
# default: falls back | required: no
#HDD_DATABASE_RO_URL=

# TLS and auth, or Unix socket.
# default: none | required: yes
#HDD_REDIS_URL=

# 32 bytes base64; escrowed offline.
# default: none | required: yes
#HDD_MASTER_KEY=

# At least 32 bytes; service tokens only.
# default: none | required: yes
#HDD_JWT_SECRET=

# 32 bytes; HMAC for cookie and session IDs.
# default: none | required: yes
#HDD_SESSION_KEY=

# 32 bytes.
# default: none | required: yes
#HDD_CSRF_KEY=

# 32 bytes; rotates with overlap window.
# default: none | required: yes
#HDD_CHALLENGE_KEY=

# 32 bytes; hashes emails in logs/attempt tables.
# default: none | required: yes
#HDD_EMAIL_HMAC_KEY=

# 32 bytes; the password pepper, passed to Argon2id as its native keyed `secret` parameter (not an HMAC pre-hash). `HDD_PEPPER_KID` is the id of the current pepper and is stored per user in `users.password_pepper_kid`.
# default: none / `1` | required: yes
#HDD_PEPPER=
#HDD_PEPPER_KID=

# The previous pepper, accepted for verification only; users are rehashed with the current pepper on their next successful login (T-0526).
# default: none | required: during rotation
#HDD_PEPPER_PREV=
#HDD_PEPPER_PREV_KID=

# Floors enforced; benchmarked at install (T-0106).
# default: `65536` / `3` / `1` | required: no
#HDD_ARGON2_M_COST_KIB=

# Platform roles: `15` / `8` fixed minimums.
# default: `60` / `12` | required: no
#HDD_SESSION_IDLE_MINUTES=

# CIDRs allowed to set XFF (CDN).
# default: empty | required: no
#HDD_TRUSTED_PROXIES=

# Plus loopback, platform IPs, origin.
# default: empty | required: no
#HDD_NEVER_BAN_CIDRS=

# Admin surface allowlist.
# default: empty | required: no
#HDD_ADMIN_CIDRS=

# First offence; ladder is configured per site.
# default: `3600` | required: no
#HDD_BAN_TTL_SECS=

# Seconds; cap 7 d.
# default: `3600,21600,86400,604800` | required: no
#HDD_BAN_TTL_LADDER=

# Soft score threshold.
# default: `5` | required: no
#HDD_BLOCK_THRESHOLD=

# Default for new sites; presets override.
# default: `1` | required: no
#HDD_PARANOIA_LEVEL=

# MaxMind-format files; country rules need them.
# default: empty | required: no
#HDD_GEOIP_DB=
#HDD_ASN_DB=

# `staging` or `production`; production gate.
# default: `staging` | required: no
#HDD_ACME_DIRECTORY=

# 
# default: none | required: yes if TLS
#HDD_ACME_EMAIL=

# Comma-separated.
# default: none | required: yes
#HDD_NS_HOSTNAMES=

# HDD edge addresses answered for proxied names.
# default: none | required: yes (v4)
#HDD_PROXY_IPV4=
#HDD_PROXY_IPV6=

# `starttls` or `implicit`; plaintext refused.
# default: none / `587` / `starttls` | required: if mail
#HDD_SMTP_HOST=

# 
# default: none | required: if mail
#HDD_SMTP_USERNAME=

# SPF/DKIM/DMARC checked by preflight.
# default: none | required: if mail
#HDD_MAIL_FROM=
#HDD_MAIL_FROM_NAME=

# `disabled`, `invite_only`, `open`.
# default: `invite_only` | required: no
#HDD_SIGNUP_MODE=

# `offline_list`, `hibp_range`, `off`.
# default: `offline_list` | required: no
#HDD_PASSWORD_BREACH_CHECK=

# Floor 10.
# default: `12` | required: no
#HDD_PASSWORD_MIN_LENGTH=

# Cannot be emptied for platform roles.
# default: `platform_owner,platform_admin,platform_support,platform_auditor` | required: no
#HDD_REQUIRE_MFA_ROLES=

# JSON logs; redaction always on.
# default: `info` | required: no
#HDD_LOG_LEVEL=

# File flag path.
# default: `/var/run/hdd-safe-mode` | required: no
#HDD_SAFE_MODE_FLAG=

# Audit floor 180 (validation rejects lower); plan caps may lower events retention only.
# default: `30` / `400` | required: no
#HDD_EVENTS_RETENTION_DAYS=

# Bounded channel.
# default: `65536` | required: no
#HDD_EVENT_QUEUE_CAPACITY=

# Default per site.
# default: `131072` | required: no
#HDD_INSPECT_BODY_MAX_BYTES=

# `inspect_prefix`, `block`, `pass`.
# default: `inspect_prefix` | required: no
#HDD_OVER_LIMIT_POLICY=

# 413 above.
# default: `10485760` | required: no
#HDD_REQUEST_BODY_MAX_BYTES=

# 431 above.
# default: `32768` | required: no
#HDD_HEADER_BLOCK_MAX_BYTES=

# 
# default: `65536` | required: no
#HDD_OUTBOUND_SCAN_WINDOW_BYTES=

# Per IP per site.
# default: `60/10s` | required: no
#HDD_RATE_DEFAULT=

# Floors/ceilings per Appendix E4.
# default: `100` / `100` / `10` / `10` | required: no
#HDD_H2_MAX_STREAMS=

# From the profile; hot reload.
# default: none | required: yes
#HDD_EGRESS_ALLOWLIST_FILE=

# Tenant origins and webhooks.
# default: `80,443,8080,8443` | required: no
#HDD_SSRF_ALLOWED_PORTS=

# 
# default: `5000` / `65536` | required: no
#HDD_WEBHOOK_TIMEOUT_MS=

# `allow`, `challenge`, `block`; per-site override.
# default: `allow` | required: no
#HDD_TOR_POLICY=

# Explicit opt-in; feeds in `threat_feeds`.
# default: `false` | required: no
#HDD_THREAT_FEEDS_ENABLED=

# Operator alert webhook.
# default: none | required: no
#HDD_ALERT_WEBHOOK_URL=

# External dead-man monitor.
# default: none | required: no
#HDD_HEARTBEAT_URL=

# Private.
# default: `127.0.0.1:9100` | required: no
#HDD_METRICS_BIND=

# `auto`, `nftables`, `ipset`, `noop`.
# default: `auto` | required: no
#HDD_FW_BACKEND=

# `auto`, `native`, `generic`, `off`.
# default: `auto` | required: no
#HDD_XDP_MODE=

# Dead-man detach timer.
# default: `120` | required: no
#HDD_XDP_DETACH_SECS=

# Vuln-Lab self-guard (section 2.8).
# default: unset | required: lab only
#HDD_LAB=
#HDD_LAB_ACK=
#HDD_LAB_CIDR=

# External status page feed.
# default: none | required: no
#HDD_STATUS_FEED_URL=

# Kill switch.
# default: `/var/run/hdd-acceptance.stop` | required: no
#HDD_ACCEPTANCE_STOP_FILE=

# 
# default: `en` | required: no
#HDD_I18N_DEFAULT_LOCALE=

# Display only.
# default: `Hack Dev Defence` | required: no
#HDD_BRAND_NAME=

# File flag.
# default: `/var/run/hdd-maintenance` | required: no
#HDD_MAINTENANCE_FLAG=

# `hosted` or `local` (R-31). `local` refuses `deployment_mode: saas`, open signup, and any action that needs privileged host integration.
# default: `hosted` | required: no
#HDD_RUNTIME_PROFILE=

# Secrets, snapshot cache, embedded database, backups; created with owner-only permissions.
# default: per-OS user data directory (local), `/var/lib/hdd` (hosted) | required: no
#HDD_DATA_DIR=

# `embedded`, `external` (uses `HDD_DATABASE_URL`) or `compose`.
# default: `embedded` | required: local
#HDD_LOCAL_DATABASE=

# `memory` is refused in `hosted` when more than one service process is registered.
# default: `memory` (local), `redis` (hosted) | required: no
#HDD_KV_BACKEND=

# Unprivileged defaults; conflicts are reported by `hdd-local doctor`.
# default: `web=8443,proxy_http=8080,proxy_https=8444,dns=5300,api=8000` | required: local
#HDD_LOCAL_PORTS=

# Must end in `.localhost` unless the hosts helper manages the names (C18.8).
# default: `hdd.localhost` | required: local
#HDD_LOCAL_SUFFIX=

# `local_ca` or `http_only` (loopback only, readiness warning).
# default: `local_ca` | required: local
#HDD_LOCAL_TLS=

# Data-plane listeners only; the acknowledgement must equal `I-UNDERSTAND-LOCAL-IS-NOT-24x7`.
# default: `false` / unset | required: local
#HDD_LOCAL_LAN_EXPOSURE=
#HDD_LOCAL_LAN_ACK=

# `true` serves the product surfaces through the HDD proxy over `platform_internal` like hosted; the default serves them directly from `hdd-web` with the controls of C18.7.
# default: `false` | required: local
#HDD_LOCAL_DOGFOOD=

# `ua_keyed` or `single`; `single` is refused while any site is in `block` mode (C18.5).
# default: `ua_keyed` | required: local
#HDD_LOCAL_LOOPBACK_IDENTITY=

# One-time first-run token (hash stored, 15-minute expiry).
# default: `<data dir>/bootstrap.token` | required: local
#HDD_LOCAL_BOOTSTRAP_TOKEN_FILE=

# Exact `Host` allowlist for the control plane (rebinding defense); derived from the surface hosts; loopback aliases only redirect (C18.7).
# default: derived | required: no
#HDD_ALLOWED_HOSTS=

# Last-known-good compiled snapshot (C18.11).
# default: `<data dir>/snapshot` | required: no
#HDD_SNAPSHOT_CACHE_DIR=

# systemd `WatchdogSec` for HDD services; each service pings via `sd_notify`.
# default: `30` | required: hosted
#HDD_WATCHDOG_SECS=

# Cron expression; target `local`, `sftp` or `s3` (the destination must be in the egress allowlist).
# default: `0 3 * * *` / `local` | required: no
#HDD_BACKUP_SCHEDULE=
#HDD_BACKUP_TARGET=

# `H1` to `H5` (C18.10); changes readiness expectations only.
# default: `H1` | required: hosted
#HDD_HOSTING_PROFILE=

# At or above this disk usage, non-critical writers pause (events are sampled, exports refused); bans and audit rows continue.
# default: `90` | required: no
#HDD_DISK_GUARD_PCT=
